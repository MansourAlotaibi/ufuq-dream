<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:theme="@style/AppTheme" android:label="@string/app_name" android:icon="@drawable/app_icon" android:banner="@drawable/tv_banner" android:supportsRtl="true" android:allowBackup="false">
        <meta-data android:name="com.ufuq.dream.SOURCE_COMMIT" android:value="@string/source_commit" />
        <activity android:name=".SettingsActivity" android:exported="true" android:screenOrientation="landscape">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /></intent-filter>
        </activity>
        <activity android:name=".PreviewActivity" android:exported="false" android:screenOrientation="landscape" />
        <service android:name=".UfuqDreamService" android:label="@string/app_name" android:exported="true" android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter><action android:name="android.service.dreams.DreamService" /></intent-filter>
            <meta-data android:name="android.service.dream" android:resource="@xml/dream" />
        </service>
    </application>
</manifest>
